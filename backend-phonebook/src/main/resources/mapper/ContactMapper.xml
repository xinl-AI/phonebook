<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.phonebook.mapper.ContactMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.phonebook.entity.Contact">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="name" property="name"/>
        <result column="phonetic_name" property="phoneticName"/>
        <result column="phone" property="phone"/>
        <result column="second_phone" property="secondPhone"/>
        <result column="email" property="email"/>
        <result column="second_email" property="secondEmail"/>
        <result column="address" property="address"/>
        <result column="birthday" property="birthday"/>
        <result column="company" property="company"/>
        <result column="position" property="position"/>
        <result column="website" property="website"/>
        <result column="remark" property="remark"/>
        <result column="is_favorite" property="isFavorite"/>
        <result column="avatar" property="avatar"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 分页查询联系人：支持按分组筛选和关键词搜索 -->
    <select id="selectContactPage" resultMap="BaseResultMap">
        SELECT DISTINCT c.*
        FROM contact c
        <if test="groupId != null">
            INNER JOIN contact_group cg ON c.id = cg.contact_id AND cg.group_id = #{groupId}
        </if>
        WHERE c.user_id = #{userId}
        AND c.is_deleted = 0
        <if test="keyword != null and keyword != ''">
            AND (c.name LIKE CONCAT('%', #{keyword}, '%')
                 OR c.phone LIKE CONCAT('%', #{keyword}, '%')
                 OR c.email LIKE CONCAT('%', #{keyword}, '%')
                 OR c.phonetic_name LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        ORDER BY c.phonetic_name ASC, c.name ASC
    </select>

    <!-- 查询收藏联系人 -->
    <select id="selectFavorites" resultMap="BaseResultMap">
        SELECT * FROM contact
        WHERE user_id = #{userId}
        AND is_favorite = 1
        AND is_deleted = 0
        ORDER BY update_time DESC
    </select>

    <!-- 查询回收站中的联系人（is_deleted=1，绕过 MyBatis-Plus 逻辑删除自动过滤） -->
    <select id="selectDeletedContacts" resultMap="BaseResultMap">
        SELECT * FROM contact
        WHERE user_id = #{userId}
        AND is_deleted = 1
        ORDER BY update_time DESC
    </select>

    <!-- 根据 ID 查询联系人（不区分 is_deleted，用于恢复） -->
    <select id="selectByIdIgnoreDeleted" resultMap="BaseResultMap">
        SELECT * FROM contact WHERE id = #{id}
    </select>

    <!-- 恢复联系人（绕过 @TableLogic 的 WHERE is_deleted=0 过滤） -->
    <update id="restoreById">
        UPDATE contact SET is_deleted = 0 WHERE id = #{id}
    </update>

    <!-- 物理删除（绕过 @TableLogic 过滤，直接 DELETE FROM） -->
    <delete id="physicalDeleteById">
        DELETE FROM contact WHERE id = #{id}
    </delete>

</mapper>
